{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-3-5-20241022",
  "default_agent": "code",
  "agent": {
    "code": {
      "mode": "primary",
      "description": "Full-access coding agent",
      "prompt": "You are Kilo Code, a skilled software engineer. Use all available tools to complete tasks efficiently.",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "shell": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "skill": "allow",
        "question": "allow",
        "todowrite": "allow",
        "external_directory": "allow"
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    ".kilo/CODING_GUIDE.md",
    ".kilo/INSTRUCTIONS.md"
  ],
  "permission": {
    "bash": {
      "docker *": "allow",
      "pip *": "allow",
      "python *": "allow",
      "uvicorn *": "allow",
      "pytest *": "allow",
      "git *": "allow",
      "curl *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "go *": "allow",
      "pwd": "allow",
      "find *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "rm *": "ask",
      "sudo *": "ask",
      "*": "allow"
    },
    "edit": {
      "src/**/*.py": "allow",
      "tests/**/*.py": "allow",
      "config.yaml": "allow",
      "pyproject.toml": "allow",
      "*.md": "allow",
      ".kilo/**/*.md": "allow",
      "*.lock": "deny",
      "*.env": "deny",
      "*": "allow"
    },
    "write": "allow",
    "shell": "allow",
    "list": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true,
  "share": "manual"
}
