# Frontend Environment Configuration
# Copy this file to .env and adjust as needed

# API Gateway base URL (HTTP)
# Leave empty for development to use Vite proxy
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_WS_RECONNECT_DELAY_MS=3000
VITE_ACTIVE_LLM_PROVIDER=deepseek
VITE_RAG_TOP_K=10
VITE_RAG_ENABLE_RERANK=true
VITE_RAG_ENABLE_FUSION=true

# Optional frontend LLM provider settings (UI/runtime defaults only)
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_KIMI_API_KEY=
VITE_KIMI_BASE_URL=https://api.moonshot.cn
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com

# Vite dev server and proxy targets (optional)
VITE_WEB_PORT=3000
VITE_NODE_URL=http://localhost:3001
VITE_RETRIEVAL_URL=http://localhost:8002
VITE_GATEWAY_URL=http://localhost:8080
VITE_WS_GATEWAY_URL=ws://localhost:8081

# WebSocket Gateway URL
# In development, leave VITE_WS_URL empty to derive ws(s)://<current-host>/ws?room=<room>
# For a fixed direct connection, use: ws://localhost:8081/ws?room=dashboard
