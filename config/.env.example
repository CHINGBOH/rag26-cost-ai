# RAG Dashboard 环境变量配置
# 复制此文件为 .env 并修改相应配置

# ========== 基础配置 ==========
APP_ENV=dev
APP_DEBUG=true
NODE_ENV=production
LOG_LEVEL=info
LOG_OUTPUT_FILE=./logs/app.log
LOG_ENABLE_CONSOLE=true
ENABLE_FILE_LOG=false
LOG_PRETTY_PRINT=false
LOG_FLUSH_INTERVAL_MS=5000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=node-orchestrator
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ========== 数据库配置 ==========
# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents
RETRIEVAL_SESSION_CONTEXT_COLLECTION=session_context
RETRIEVAL_DOCUMENTS_COLLECTION=documents
RETRIEVAL_DOCUMENTS_INDEX_NAME=documents
# 连接池配置
QDRANT_TIMEOUT=30
QDRANT_POOL_SIZE=10

# Elasticsearch 关键词数据库
ES_HOST=http://localhost:9200
ES_INDEX_NAME=documents
ES_USERNAME=  # 可选，如果需要认证
ES_PASSWORD=  # 可选，如果需要认证
CASCADE_RETRIEVAL_ENABLE_ELASTICSEARCH=false
# 连接池配置
ES_MAX_CONNECTIONS=20
ES_TIMEOUT=30

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=  # 必填，生产环境请修改为强密码
CASCADE_RETRIEVAL_ENABLE_NEO4J=false
NEO4J_DATABASE=neo4j
# 连接池配置
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# Redis 缓存
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # 可选，如果需要认证
REDIS_TTL=3600
# 连接池配置
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=10

# ========== 模型配置 ==========
# Embedding 模型
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MODEL_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# TEI (Text Embeddings Inference) 配置
# 设置 EMBEDDING_BACKEND=tei 使用 TEI 服务，设为 local 使用本地 sentence-transformers
EMBEDDING_BACKEND=tei
TEI_URL=http://localhost:8003
TEI_MODEL_ID=BAAI/bge-m3
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CLIENT_BATCH_SIZE=64
FEEDBACK_LOG_PATH=
RAG_PIPELINE_JOBS_DIR=
RAG_PIPELINE_UPLOAD_DIR=
OCR_SERVICE_URL=http://localhost:8001
QDRANT_INGEST_COLLECTION=document_chunks
MILVUS_HEALTH_URL=http://localhost:9091/healthz
KEYWORD_BACKEND=es
VECTOR_BACKEND=qdrant
DEEPSEEK_BASE_URL=
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=Qwen2.5-14B-Instruct
LOCAL_LLM_ENGINE=llama.cpp

# Reranker 模型
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# ========== 服务器配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=true

# ========== 检索配置 ==========
RETRIEVAL_VECTOR_TOP_K=30
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_GRAPH_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.6
RETRIEVAL_ENABLE_RERANK=true
RETRIEVAL_ENABLE_FUSION=true

# ========== 分数融合权重 ==========
FUSION_WEIGHT_RERANK=0.4
FUSION_WEIGHT_VECTOR=0.3
FUSION_WEIGHT_KEYWORD=0.2
FUSION_WEIGHT_GRAPH=0.05
FUSION_WEIGHT_TIME=0.05

# ========== 上下文配置 ==========
CONTEXT_MAX_LENGTH=2000
CONTEXT_SURROUNDING_WINDOW=2
CONTEXT_STRATEGY=surrounding

# ========== 日志配置 ==========
LOGGING_LEVEL=INFO
LOGGING_FORMAT=json
LOGGING_OUTPUT=stdout

# ========== LLM API 配置 ==========
# 主 LLM 提供商: openai | claude | kimi | ollama | custom | deepseek
LLM_PROVIDER=kimi
LLM_API_KEY=your_api_key_here
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.kimi.com/coding/v1
LLM_MODEL=kimi-for-coding
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OCR 校验专用 LLM (可选，使用较小模型节省成本)
LLM_VERIFY_PROVIDER=kimi
LLM_VERIFY_API_KEY=
LLM_VERIFY_MODEL=kimi-for-coding

# ========== OCR 质量配置 ==========
OCR_QUALITY_THRESHOLD=0.85
OCR_TABLE_INTEGRITY_THRESHOLD=0.90
OCR_MAX_RETRIES=3
OCR_ENABLE_LLM_VERIFY=true
OCR_LANGUAGE=ch
OCR_DPI=300
OCR_TIMEOUT_MS=300000
OCR_USE_GPU=false
OCR_CHUNK_SIZE=512
OCR_CHUNK_OVERLAP=50
OCR_MIN_CHUNK_SIZE=100

# ========== 服务开关 ==========
# API 服务
SERVICE_API_ENABLED=true
SERVICE_API_PORT=8000

# OCR 服务
SERVICE_OCR_ENABLED=true
SERVICE_OCR_PORT=8001
SERVICE_OCR_GPU=false

# Node.js 递归服务 (默认不启用)
SERVICE_RECURSION_ENABLED=false
SERVICE_RECURSION_PORT=3001
SERVICE_RECURSION_MAX_DEPTH=3

# ========== 结构化存储配置 ==========
# PostgreSQL (表格数据存储)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your_password_here
CASCADE_RETRIEVAL_ENABLE_POSTGRES=false
CASCADE_RETRIEVAL_DEFAULT_TOP_K=10
CASCADE_RETRIEVAL_VECTOR_WEIGHT=0.5
CASCADE_RETRIEVAL_GRAPH_WEIGHT=0.3
CASCADE_RETRIEVAL_KEYWORD_WEIGHT=0.2
# Chinese BM25 text search config (requires zhparser in Postgres image)
# Use "chinese" when running rag-postgres:16-zhparser; falls back to "simple" automatically
PG_TSV_CONFIG=chinese

# ========== 监控配置 ==========
METRICS_ENABLED=true
METRICS_PORT=9090

# ========== Pydantic Settings 环境变量 (使用 __ 作为分隔符) ==========
# 示例: APP__SERVER__HOST=0.0.0.0
#       APP__VECTOR_STORE__HOST=localhost
#       APP__MODELS__EMBEDDING__DEVICE=cuda
# 以下环境变量会被 Pydantic Settings 自动识别
# APP_VECTOR_STORE__HOST=localhost
# APP_VECTOR_STORE__PORT=6333
# APP_GRAPH_STORE__PASSWORD=your_password_here
# APP_MODELS__RERANK__NAME=BAAI/bge-reranker-large
# ==================== Gateway & WebSocket ====================
GO_SERVICES_CONFIG_FILE=
GATEWAY_PORT=8080
GATEWAY_HEALTHCHECK_TIMEOUT=5s
WS_GATEWAY_PORT=8081
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_ALLOW_ALL_ORIGINS=true
WS_GATEWAY_URL=http://localhost:8081/broadcast
NODEJS_URL=http://localhost:3001
PYTHON_URL=http://localhost:8000
OCR_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002
LLM_URL=http://localhost:8003
WS_PUBLIC_URL=ws://localhost:8081/ws
REDIS_URL=redis://localhost:6379
STORAGE_REDIS_QUEUE_NAME=queue:default
STORAGE_REDIS_STORE_KEY_PREFIX=store:
STORAGE_REDIS_MAX_RETRIES_PER_REQUEST=3
STORAGE_REDIS_RETRY_MAX_DELAY_MS=3000

# ==================== Node Orchestrator runtime overrides ====================
# These override src/backend/server/config/default.json when the Node service starts.
CORS_ORIGIN=http://localhost:3000
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_CONNECTION_TIMEOUT_MS=30000
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
HEARTBEAT_BROADCAST_INTERVAL_MS=3000
HEARTBEAT_SILENCE_THRESHOLD_MS=30000
SYSTEM_STATUS_LOG_INTERVAL_MS=60000
PIPELINE_UPLOAD_DIR=/tmp/rag-uploads
PIPELINE_MAX_CONCURRENT=5
PIPELINE_LOOP_INTERVAL_MS=1000
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_KEY_PREFIX=rag:
TASK_QUEUE_CONCURRENCY=3
TASK_QUEUE_EVALUATION_CONCURRENCY=5
TASK_QUEUE_OCR_CONCURRENCY=2
RECURSION_CLEANUP_INTERVAL_MS=600000
RECURSION_COMPLETED_SESSION_MAX_AGE_MS=86400000
RECURSION_HARD_SESSION_MAX_AGE_MS=604800000
RECURSION_REQUEST_TIMEOUT_MS=120000
AUTH_SECRET=
AUTH_TOKEN_EXPIRY_SECONDS=86400
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
PERSISTENCE_ENABLED=false
PERSISTENCE_CONNECTION_STRING=
PERSISTENCE_SSL=false
EXPERT_JUDGMENT_BASE_URL=https://api.kimi.com/coding/v1
EXPERT_JUDGMENT_API_KEY=
EXPERT_JUDGMENT_MODEL=kimi-for-coding
EXPERT_JUDGMENT_TEMPERATURE=0.3
EXPERT_JUDGMENT_MAX_TOKENS=2000
