
# ==================== 腾讯云短信 ====================
# SMS_ENABLED=true 时开启短信登录，填好下方5个参数再重启
SMS_ENABLED=false
# 腾讯云 API 密钥（访问管理 -> API密钥管理）
TENCENT_SMS_SECRET_ID=your_secret_id_here
TENCENT_SMS_SECRET_KEY=your_secret_key_here
# 短信应用 SDK AppID（国内短信 -> 应用管理 -> 应用列表）
TENCENT_SMS_SDK_APP_ID=your_sdk_app_id_here
# 短信签名（必须已审核通过）
TENCENT_SMS_SIGN_NAME=your_sign_name_here
# 验证码模板 ID（模板内容需包含 {1} 为验证码、{2} 为有效期分钟数）
TENCENT_SMS_TEMPLATE_ID=your_template_id_here
