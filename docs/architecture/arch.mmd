graph TB
    subgraph FE["🖥️ Frontend (Vite :3000)"]
        direction TB
        UI[React 18 App]
        RAG[ragApi.ts]
        LLM[llmApi.ts 🔴 Mock]
        WS[useWebSocket.ts]
    end

    subgraph PROXY["⚡ Vite Dev Proxy"]
        direction TB
        P_AGENT["/api/agent → :3001"]
        P_SEARCH["/api/search → :8000 🔴 绕过Gateway"]
        P_V1["/api/v1 → :8000 🔴 绕过Gateway"]
        P_API["/api → :8080"]
        P_WS["/ws → :8081"]
    end

    subgraph GW["🌐 Go Gateway (:8080)"]
        direction TB
        G_PROXY[ProxyHandler]
        G_ROUTE{路由映射}
        G_NODE["/api/sessions<br>/api/pipeline<br>/api/auth → nodejs"]
        G_RET["/api/search<br>/api/v1/search → retrieval 🔵 未被使用"]
        G_PY["/api/v1/embedding → python"]
        G_OCR["/api/ocr → ocr"]
        G_WS_GW["/ws → websocket"]
    end

    subgraph NODE["🟢 Node.js (:3001)"]
        direction TB
        N_API[Fastify API]
        N_WS_MGR[WebSocketManager<br>HTTP POST转发]
        N_CTRL[RecursionController]
    end

    subgraph PY["🐍 Python Legacy (:8000)"]
        direction TB
        PY_API[FastAPI Unified]
        PY_EMB[Embedding]
        PY_ING[Ingestion]
    end

    subgraph RET["🔍 Retrieval (:8002)"]
        direction TB
        R_API[Search/Rerank API]
    end

    subgraph GOWS["📡 Go WebSocket (:8081)"]
        direction TB
        W_SERVER[WS Gateway]
        W_HUB[Hub]
    end

    UI --> RAG
    UI --> LLM
    UI --> WS

    RAG --> P_SEARCH
    RAG --> P_V1
    RAG --> P_API
    LLM --> P_AGENT
    WS --> P_WS

    P_API --> G_PROXY
    G_PROXY --> G_ROUTE
    G_ROUTE --> G_NODE
    G_ROUTE --> G_RET
    G_ROUTE --> G_PY
    G_ROUTE --> G_OCR
    G_ROUTE --> G_WS_GW

    G_NODE --> N_API
    N_API --> N_WS_MGR
    N_WS_MGR --> W_SERVER
    P_WS --> W_SERVER
    G_WS_GW --> W_SERVER

    P_SEARCH -.->|"❌ 绕过Gateway"| PY_API
    P_V1 -.->|"❌ 绕过Gateway"| PY_API
