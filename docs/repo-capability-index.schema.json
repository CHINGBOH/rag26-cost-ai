{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chingboh.github.io/RAG26/repo-capability-index.schema.json",
  "title": "Repo Capability Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "project",
    "status_legend",
    "maintenance",
    "topology",
    "resources"
  ],
  "properties": {
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "path",
        "purpose",
        "monorepo",
        "stacks",
        "last_updated"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "path": { "const": "." },
        "purpose": { "type": "string", "minLength": 1 },
        "monorepo": { "type": "boolean" },
        "stacks": { "$ref": "#/definitions/stringArray" },
        "last_updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "status_legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "legacy",
        "internal-only",
        "supporting"
      ],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "legacy": { "type": "string", "minLength": 1 },
        "internal-only": { "type": "string", "minLength": 1 },
        "supporting": { "type": "string", "minLength": 1 }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_when",
        "authoring_rules"
      ],
      "properties": {
        "update_when": { "$ref": "#/definitions/stringArray" },
        "authoring_rules": { "$ref": "#/definitions/stringArray" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_entrypoints",
        "notes",
        "connections"
      ],
      "properties": {
        "routing_entrypoints": { "$ref": "#/definitions/relativePathArray" },
        "notes": { "$ref": "#/definitions/stringArray" },
        "connections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "via",
              "paths"
            ],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "via": { "type": "string", "minLength": 1 },
              "paths": { "$ref": "#/definitions/stringArray" },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/resource" }
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+"
    },
    "relativePathArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/relativePath" }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "path",
        "languages",
        "stack",
        "purpose",
        "status",
        "entrypoints",
        "usage_cues",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "config-entrypoint",
            "package",
            "workspace",
            "script",
            "infrastructure",
            "doc"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/definitions/relativePath" },
        "languages": { "$ref": "#/definitions/stringArray" },
        "stack": { "$ref": "#/definitions/stringArray" },
        "purpose": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "canonical",
            "legacy",
            "internal-only",
            "supporting"
          ]
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "entrypoints": { "$ref": "#/definitions/relativePathArray" },
        "notable_exports": { "$ref": "#/definitions/stringArray" },
        "capabilities": { "$ref": "#/definitions/stringArray" },
        "key_commands": { "$ref": "#/definitions/stringArray" },
        "usage_cues": { "$ref": "#/definitions/stringArray" },
        "tags": { "$ref": "#/definitions/stringArray" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "doc" }
            }
          },
          "then": {},
          "else": {
            "required": [
              "capabilities"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "go-api-gateway",
                  "node-orchestrator",
                  "node-runtime-config",
                  "retrieval-service",
                  "python-legacy-api",
                  "ocr-service",
                  "shared-package",
                  "python-runtime-config-loader",
                  "retrieval-runtime-config",
                  "retrieval-runtime-overrides",
                  "python-legacy-runtime-config",
                  "frontend-runtime-config",
                  "go-gateway-runtime-config",
                  "go-gateway-route-map"
                ]
              }
            }
          },
          "then": {
            "required": [
              "notable_exports"
            ]
          }
        }
      ]
    }
  }
}
